    {
      "kind": "measurement",
      "subject": "שבעת שרי",
      "rationale": "Жети төрө — санап көрсөтүү, тизмедеги аттар менен."
    },
    {
      "kind": "wordplay",
      "subject": "מרס \/ מרסנא",
      "rationale": "Мерес жана Марсена — үнү жакын аттар, тизме ыргагын күчөтөт."
    }
