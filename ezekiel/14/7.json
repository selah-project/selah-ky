    {
      "kind": "idiom",
      "subject": "жүрөгүнө көтөрүп",
      "rationale": "ивритче 'буттарын жүрөгүнө көтөрөт' — жүрөгүнө орнотот деген сүрөт"
    },
    {
      "kind": "idiom",
      "subject": "Өзүм жооп беремин",
      "rationale": "ивритче 'Менин өзүмдө ага жооп беремин' — Өзүм аркылуу, башка жол менен эмес"
    },
    {
      "kind": "substitution",
      "subject": "тоскоол",
      "rationale": "מכשול — аягын илинүүчү таш, жыгач; 'сөөк таш' сүрөтү жумшарды"
    }
  ],
  "translation": "Анткени Йисраэл үй-бүлөсүнөн ар бир адам жана Йисраэлде конуп жүргөн чет элдик — ал Менден четтеп, өз буттарын жүрөгүнө көтөрүп, күнөөсүнүн тоскоолун жүзүнүн алдына коюп, набийге Мен жөнүндө сурап келсе — Мен, Яхве, ага Өзүм жооп беремин.",
