    {
      "kind": "crux",
      "subject": "хашифей иазим",
      "rationale": "'Эки майда козу-улактын тобу' — кичинекей, бөлүнүп калган топ; кээ бир котормолор 'кичине' деген сын атоочту кошот."
    },
    {
      "kind": "wordplay",
      "subject": "кичүүлүк менен көптүк",
      "rationale": "Эки майда топ менен жерди толтургон Арамдын контрасты — риторикалык карама-каршылык."
    }
