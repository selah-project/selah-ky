    {
      "kind": "crux",
      "subject": "אצדיק",
      "rationale": "«Мен жаманды актаймын» (соттук актоо) же «жаман Мен үчүн ак болбойт» — иврит causative форма биринчини билдирет."
    },
    {
      "kind": "addition",
      "subject": "Мен",
      "rationale": "אצדיק этишинин 1-жак мүчөсү кыргызча атайын аталуу керек болду."
    }
  ],
