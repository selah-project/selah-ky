    {
      "kind": "idiom",
      "subject": "סקול יסקל",
      "rationale": "Инфинитивдин абсолюттуу кайталоосу — «албаты ташталат» деген бекемдөө; кыргызча «таш барк этилет» деп берилди."
    },
    {
      "kind": "substitution",
      "subject": "йовел",
      "rationale": "היבל — кочкордун карнысынын узун үнү; кийин «жубилей» деген атка айланган сөз."
    },
    {
      "kind": "elision",
      "subject": "במשך",
      "rationale": "«Тартуу\/чертүү» деген тамыр «үнү узаганда» деген туюлма менен берилди."
    }
  ],
  "translation": "Ага кол тийгизилбесин, анткени ал таш барк этилет же жебе менен атылат; мал болобу, адам болобу — жашабайт; йовелдин үнү узаганда алар тоого чыгышат.",
